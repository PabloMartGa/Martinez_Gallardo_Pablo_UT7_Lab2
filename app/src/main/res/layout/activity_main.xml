<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo"
            android:textColor="@color/marron_oscuro"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Nombre del fichero -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_nombre"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <!-- Texto del pergamino -->
        <EditText
            android:id="@+id/etContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="@string/hint_contenido"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="6" />

        <!-- Tipo de pergamino: interno (confidencial) o externo (mapa) -->
        <RadioGroup
            android:id="@+id/rgTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbInterno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/tipo_interno" />

            <RadioButton
                android:id="@+id/rbExterno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tipo_externo" />
        </RadioGroup>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/btn_guardar" />

            <Button
                android:id="@+id/btnLeer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/btn_leer" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEjemplo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_ejemplo" />

        <!-- Mensaje de estado (ruta donde se guardó o leyó el fichero) -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/marron"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <!-- Texto leído del fichero -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/resultado_titulo"
            android:textColor="@color/marron_oscuro"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/marron_oscuro"
            android:textIsSelectable="true"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>